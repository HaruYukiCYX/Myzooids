<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">
    <!-- background设为黑色，让相机预览边缘融合 -->

    <!-- ================== 主界面 (ScrollView) ================== -->
    <!-- 当相机开启时，我们在代码中将其设为 GONE -->
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 蓝牙列表头部会动态添加到这里 -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:padding="16dp"
                android:text="机器人控制区"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 功能区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- 智能取物 -->
                <LinearLayout
                    android:id="@+id/ll_fetch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_item_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_fetch" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="智能取物"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 打开摄像头 -->
                <LinearLayout
                    android:id="@+id/ll_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="打开摄像头"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 智能提醒 -->
                <LinearLayout
                    android:id="@+id/ll_notification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_notification" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="智能提醒"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 机器人操作区 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:padding="16dp"
                android:text="机器人操作区"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 方向控制 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_control_circle">

                    <!-- 中心圆 -->
                    <View
                        android:id="@+id/view_center"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_control_center" />

                    <!-- 上箭头 -->
                    <ImageButton
                        android:id="@+id/btn_up"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="20dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="向前移动"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_up" />

                    <!-- 下箭头 -->
                    <ImageButton
                        android:id="@+id/btn_down"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="20dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="向后移动"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_down" />

                    <!-- 左箭头 -->
                    <ImageButton
                        android:id="@+id/btn_left"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="20dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="向左移动"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_left" />

                    <!-- 右箭头 -->
                    <ImageButton
                        android:id="@+id/btn_right"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="20dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="向右移动"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_right" />
                </FrameLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ================== 相机层 (全屏覆盖) ================== -->

    <!-- JavaCameraView: 必须设为 match_parent -->
    <org.opencv.android.JavaCameraView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 误差显示文本: 放在相机之上 -->
    <TextView
        android:id="@+id/tv_distance_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:background="#66000000"
        android:padding="8dp"
        android:text="当前误差：-- cm"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 关闭按钮: 放在右上角 -->
    <ImageButton
        android:id="@+id/btn_close_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭相机预览"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="gone"
        app:tint="@android:color/white" />

</FrameLayout>