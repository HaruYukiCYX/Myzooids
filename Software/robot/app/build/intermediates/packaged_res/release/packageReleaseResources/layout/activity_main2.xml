<?xml version="1.0" encoding="utf-8"?>
<!-- 使用FrameLayout作为根布局，以便相机预览可以覆盖其他控件 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 主内容滚动区域 - 初始显示的控制界面 -->
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bluetooth header will be injected here programmatically -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="机器人控制区"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:background="#F5F5F5"/>

            <!-- 功能区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <!-- 智能取物 -->
                <LinearLayout
                    android:id="@+id/ll_fetch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_item_selected"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_fetch"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="智能取物"
                        android:textColor="#333333"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 打开摄像头 -->
                <LinearLayout
                    android:id="@+id/ll_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_feature_item"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_camera"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="打开摄像头"
                        android:textColor="#333333"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- 智能提醒 -->
                <LinearLayout
                    android:id="@+id/ll_notification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/bg_feature_item"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_notification"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="智能提醒"
                        android:textColor="#333333"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 机器人操作区 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="机器人操作区"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:background="#F5F5F5"/>

            <!-- 方向控制 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_control_circle">

                    <!-- 中心圆 -->
                    <View
                        android:id="@+id/view_center"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_control_center"/>

                    <!-- 上箭头 -->
                    <ImageButton
                        android:id="@+id/btn_up"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="20dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_up"
                        android:background="@android:color/transparent"
                        android:contentDescription="向前移动"/>

                    <!-- 下箭头 -->
                    <ImageButton
                        android:id="@+id/btn_down"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="20dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_down"
                        android:background="@android:color/transparent"
                        android:contentDescription="向后移动"/>

                    <!-- 左箭头 -->
                    <ImageButton
                        android:id="@+id/btn_left"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="20dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_left"
                        android:background="@android:color/transparent"
                        android:contentDescription="向左移动"/>

                    <!-- 右箭头 -->
                    <ImageButton
                        android:id="@+id/btn_right"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="20dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_arrow_right"
                        android:background="@android:color/transparent"
                        android:contentDescription="向右移动"/>
                </FrameLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- res/layout/activity_main.xml -->
    <org.opencv.android.JavaCameraView
        android:id="@+id/camera_view"
        class="org.opencv.android.JavaCameraView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rotationY="0"
        android:visibility="visible" />


    <!-- 相机预览模式下的返回按钮 -->
    <ImageButton
        android:id="@+id/btn_close_camera"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:layout_gravity="top|end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="gone"
        android:contentDescription="关闭相机预览"
        app:tint="@android:color/white" />

</FrameLayout>
